ARG BASE_IMAGE=fedora:44@sha256:43b29f65a41eb9c35e1cd5323e3bdf3b655c2357a9f4f1ff2f9c2798e5045d80
FROM ${BASE_IMAGE}

ARG RPM_PLATFORM
ARG PG_CONFIG_PATH

ENV PKG_CONFIG_PATH=/usr/local/lib64/pkgconfig:/usr/local/lib/pkgconfig

WORKDIR /opt/pg-oauth-validator
COPY scripts/ci/install-rpm-dependencies.sh ./scripts/ci/install-rpm-dependencies.sh
RUN ./scripts/ci/install-rpm-dependencies.sh "$RPM_PLATFORM" \
    && dnf clean all
COPY scripts/ci/install-jansson.sh scripts/ci/install-libjwt.sh ./scripts/ci/
COPY scripts/ci/prepare-rpm-sources.py ./scripts/ci/prepare-rpm-sources.py
RUN python3 scripts/ci/prepare-rpm-sources.py fetch /opt/rpm-dependencies \
    && JANSSON_SOURCE_ARCHIVE=/opt/rpm-dependencies/jansson.tar.gz ./scripts/ci/install-jansson.sh \
    && LIBJWT_SOURCE_ARCHIVE=/opt/rpm-dependencies/libjwt.tar.gz ./scripts/ci/install-libjwt.sh \
    && dnf install --assumeyes rpm-build cpio elfutils \
    && dnf clean all
COPY tools/dev/run-tests.sh ./tools/dev/run-tests.sh

ENV PG_MAJOR=18
ENV PG_CONFIG_PATH=${PG_CONFIG_PATH}
ENV LD_LIBRARY_PATH=/usr/local/lib
ARG BASE_IMAGE
ARG BUILD_SOURCE_REVISION
LABEL org.opencontainers.image.revision=$BUILD_SOURCE_REVISION
LABEL org.opencontainers.image.base.name=$BASE_IMAGE
WORKDIR /workspace
ENTRYPOINT ["/bin/sh", "/opt/pg-oauth-validator/tools/dev/run-tests.sh"]
