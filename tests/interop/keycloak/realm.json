{
  "realm": "pg-oauth",
  "enabled": true,
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "clients": [
    {
      "clientId": "postgres-test",
      "name": "PostgreSQL OAuth interoperability client",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "keycloak-interop-client-secret",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "attributes": {
        "access.token.header.type.rfc9068": "true"
      },
      "defaultClientScopes": ["basic"],
      "optionalClientScopes": ["connect:postgres"],
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "postgres-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "https://postgres.example/",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "subject",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "wrong-audience-test",
      "name": "Negative interoperability client without PostgreSQL audience",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "keycloak-interop-client-secret",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "attributes": {
        "access.token.header.type.rfc9068": "true"
      },
      "defaultClientScopes": ["basic"],
      "optionalClientScopes": ["connect:postgres"],
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "subject",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clientScopes": [
    {
      "name": "connect:postgres",
      "description": "Permission to connect to the PostgreSQL resource",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    }
  ],
  "users": [
    {
      "username": "alice",
      "firstName": "Alice",
      "lastName": "Interop",
      "email": "alice@example.invalid",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "keycloak-interop-user-password",
          "temporary": false
        }
      ]
    }
  ]
}
