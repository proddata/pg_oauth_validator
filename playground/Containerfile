ARG POSTGRES_IMAGE=postgres:18.6-bookworm@sha256:1c59e2c3c818eaa0f0628f695b36e7c9e362d6b219b36a54a32df645cbd7e1af
FROM ${POSTGRES_IMAGE}

ARG PG_MAJOR
WORKDIR /workspace
COPY . .

RUN ./scripts/ci/install-debian-dependencies.sh "$PG_MAJOR" \
    && case "$PG_MAJOR" in \
         18) oauth_package_version=18.6-1.pgdg12+2 ;; \
         19) oauth_package_version=19~beta3-1.pgdg12+1 ;; \
       esac \
    && apt-get install --yes --no-install-recommends \
         "libpq-oauth=$oauth_package_version" \
    && ./scripts/ci/install-jansson.sh \
    && ./scripts/ci/install-libjwt.sh \
    && make PG_CONFIG="/usr/lib/postgresql/$PG_MAJOR/bin/pg_config" all \
    && make PG_CONFIG="/usr/lib/postgresql/$PG_MAJOR/bin/pg_config" install \
    && make PG_CONFIG="/usr/lib/postgresql/$PG_MAJOR/bin/pg_config" clean \
    && chmod 0755 /workspace/playground/postgres/entrypoint.sh \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /
